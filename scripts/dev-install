#!/bin/bash
# Build OmniGear and install it into the running shell.
#
# Mirrors what `omarchy plugin add` produces — the repo, minus build output —
# so what you test is what a user would get.
#
# The shell notices a changed plugin file and logs that it is reloading, but a
# bar widget that is already on the bar keeps its existing instance: QML edits
# do not take effect until the shell restarts. Only the Go binary picks up
# changes on its own, because it is re-run on every poll. So this restarts the
# shell, which is disruptive but is the difference between testing your changes
# and testing the last ones.

set -euo pipefail

cd "$(dirname "$0")/.."
REPO="$PWD"
ID=$(jq -r '.id' manifest.json)
TARGET="$HOME/.config/omarchy/plugins/$ID"

echo "building omnigear..."
mise exec -- go build -ldflags="-s -w" -o bin/omnigear .

echo "installing $ID -> $TARGET"
mkdir -p "$TARGET"
rsync -a --delete \
  --exclude '.git' \
  --exclude '/scripts' \
  "$REPO/" "$TARGET/"

omarchy plugin validate "$TARGET"

if [[ ${1:-} == --no-restart ]]; then
  omarchy-shell shell rescanPlugins >/dev/null
  echo "installed (shell not restarted; QML changes will not be live)"
else
  echo "restarting shell so QML changes take effect..."
  omarchy-restart-shell >/dev/null 2>&1 &
  sleep 5
fi

echo "installed. enable it with: omarchy plugin enable $ID"
